#!/usr/bin/env bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [[ ! -f "$repo/package.json" || ! -f "$repo/cli/package.json" ]]; then
  echo '请在个人仓库源码目录运行 ./install；安装说明见 https://github.com/someone97421/ck-pi-desktop-browse' >&2
  exit 1
fi

cd "$repo"
bun install --frozen-lockfile
cd cli
bun install --frozen-lockfile
bun run build
node dist/cli.mjs install "$@"
